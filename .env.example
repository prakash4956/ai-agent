# This is the one .env file for the whole course. Copy this file to .env, or let check.py
# copy it for you on its first run. .env is listed in .gitignore and never reaches GitHub.
# Exactly one provider block is active at a time: the three lines without a # at the start.
# To switch providers, put a # in front of the three active lines and remove the # from
# another block. The instructor tells you which block to use before the session.

# ---- OpenCode Zen, from https://opencode.ai (free models, no daily cap that matters). ACTIVE. ----
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=paste-your-opencode-zen-key-here
LLM_MODEL=paste-a-free-model-name-here
# check.py prints the model names your key can use. Use one of those.

# ---- Gemini, from Google AI Studio (https://aistudio.google.com/app/apikey). Inactive. ----
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=paste-your-gemini-key-here
# LLM_MODEL=gemini-3.5-flash-lite

# ---- OpenRouter, from https://openrouter.ai/keys. Inactive. ----
# The model below followed the course's action format end to end in the dry run of
# 2026-10-26; the instructor re-tests it before each cohort, because free models change.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=paste-your-openrouter-key-here
# LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# ---- Offline fallback. Remove the # only if the instructor says the search service is down. ----
# USE_FIXTURES=1
